# CreatorHandle configuration — copy to `.env` (gitignored) and fill in.
#
#   cp .env.example .env
#
# One file feeds everything: Docker Compose (variable substitution + env_file),
# the backend when run directly from backend/, the Vite dev servers (VITE_*
# only) and Playwright. Values marked "changethis" must be replaced before any
# deployment; the backend refuses to start with them outside ENVIRONMENT=local.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- General -----------------------------------------------------------------
PROJECT_NAME=CreatorHandle
# local | staging | production
ENVIRONMENT=local
# The single public origin (site, /@username, /app dashboard, /api).
# Used for email links and CORS. Production: https://yourdomain.com
FRONTEND_HOST=http://localhost:5173
# Public domain Caddy gets a TLS certificate for (compose.prod.yml only)
DOMAIN=localhost

# --- Backend -----------------------------------------------------------------
# Required in every environment. If unset outside Docker, each process
# generates its own random key and tokens stop working across restarts.
SECRET_KEY=changethis
# Uvicorn worker processes (each costs memory; 2 is plenty for a small VPS)
WEB_CONCURRENCY=2
# Extra allowed CORS origins, comma-separated (FRONTEND_HOST is always allowed)
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173
# Seeded on first start
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
# Optional error tracking
SENTRY_DSN=
# DEBUG | INFO | WARNING | ERROR. Logs are text when ENVIRONMENT=local, JSON lines otherwise.
LOG_LEVEL=INFO
# Per-IP limits on login, signup, recovery, uploads, inquiries. Unset = on
# everywhere except ENVIRONMENT=local (e2e tests create many accounts).
# RATE_LIMIT_ENABLED=true

# --- PostgreSQL --------------------------------------------------------------
# "localhost" when running the backend on the host; compose overrides it to "db"
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# --- Email (dev: compose routes mail to Mailcatcher at http://localhost:1080) --
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# --- Object storage for uploads (RustFS, S3-compatible) ----------------------
# Uploads are disabled if unset. Compose sets the endpoint to http://rustfs:9000.
# Production: openssl rand -base64 24
S3_ACCESS_KEY=creatorhandle
S3_SECRET_KEY=changethis
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=media
# MEDIA_MAX_UPLOAD_MB=5

# --- Google OAuth (optional) -------------------------------------------------
# Authorized JavaScript origins must include http://localhost:5173 and your domain.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Docker images -----------------------------------------------------------
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
# TAG=latest

# --- Frontend dev servers & Playwright ---------------------------------------
# VITE_* values are baked into the JS bundle at build time: never put secrets here.
VITE_API_URL=http://localhost:8000
MAILCATCHER_HOST=http://localhost:1080
