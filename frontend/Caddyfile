# One origin serves everything:
#   /api, /docs, /redoc  -> backend
#   /media/*             -> uploaded images (object storage, read-only)
#   /app/*               -> creator-workspace (dashboard)
#   everything else      -> creator-site (marketing page, /@username profiles)
#
# SITE_ADDRESS is the public domain in production (Caddy then handles HTTPS
# and the HTTP->HTTPS redirect automatically). Locally it defaults to plain :80.
# Serves one SPA from the root dir given as the first argument.
(spa) {
	root * {args[0]}

	# Hashed build assets never change; a missing one is a real 404, not index.html.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is a client-side route: serve index.html, and make sure
	# browsers revalidate it so a new deploy is picked up.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	# Crawler files are generated by the backend (published profiles, domain)
	rewrite /robots.txt /api/v1/seo/robots.txt
	rewrite /sitemap.xml /api/v1/seo/sitemap.xml

	@backend path /api/* /docs /docs/* /redoc /redoc/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Uploaded images live in the "media" bucket of the object storage, whose
	# path-style URLs (/media/images/...) match ours, so no rewrite is needed.
	# Files have random names and never change, hence the long cache. The
	# bucket policy only allows anonymous reads of images/* (no listing).
	handle /media/* {
		@write not method GET HEAD
		respond @write 405

		reverse_proxy rustfs:9000 {
			header_up Host {upstream_hostport}
			header_down Content-Security-Policy "default-src 'none'; sandbox"
			header_down -x-amz-request-id
			header_down -x-request-id
		}
	}

	redir /app /app/ permanent

	# The dashboard used to live at the site root. Keep old bookmarks and links
	# (login, signup, password reset, dashboard pages) working.
	@legacy path /login /signup /recover-password /reset-password /settings /brands /projects /tasks /team /admin
	redir @legacy /app{uri}

	# The dashboard is built with base "/app/", so its files sit at the dist
	# root; handle_path strips the /app prefix before looking them up.
	handle_path /app/* {
		import spa /srv/creator-workspace
	}

	# A creator's page is the same SPA, but its HTML carries that creator's
	# title, description and share image, so link previews and crawlers that
	# don't run JavaScript see them. profile.html is index.html with the
	# default tags swapped for a template include (scripts/profile-template.awk);
	# the backend escapes everything it returns, braces included.
	@profile path_regexp profile ^/@([A-Za-z0-9._-]+)(/.*)?$
	handle @profile {
		root * /srv/creator-site
		header Cache-Control "no-cache"
		rewrite * /profile.html
		templates
		file_server
	}

	handle {
		import spa /srv/creator-site
	}
}
