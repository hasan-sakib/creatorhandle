# One origin serves everything:
#   /api, /docs, /redoc  -> backend
#   /app/*               -> creator-workspace (dashboard)
#   everything else      -> creator-site (marketing page, /@username profiles)
#
# SITE_ADDRESS is the public domain in production (Caddy then handles HTTPS
# and the HTTP->HTTPS redirect automatically). Locally it defaults to plain :80.
# Serves one SPA from the root dir given as the first argument.
(spa) {
	root * {args[0]}

	# Hashed build assets never change; a missing one is a real 404, not index.html.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is a client-side route: serve index.html, and make sure
	# browsers revalidate it so a new deploy is picked up.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	@backend path /api/* /docs /docs/* /redoc /redoc/*
	handle @backend {
		reverse_proxy backend:8000
	}

	redir /app /app/ permanent

	# The dashboard used to live at the site root. Keep old bookmarks and links
	# (login, signup, password reset, dashboard pages) working.
	@legacy path /login /signup /recover-password /reset-password /settings /brands /projects /tasks /team /admin /items
	redir @legacy /app{uri}

	# The dashboard is built with base "/app/", so its files sit at the dist
	# root; handle_path strips the /app prefix before looking them up.
	handle_path /app/* {
		import spa /srv/creator-workspace
	}

	handle {
		import spa /srv/creator-site
	}
}
